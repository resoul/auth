# Process environment of `airlance-auth serve`. The service reads only the process
# environment and does not load this file; make real loads it for HTTPS/real SMTP.
# Otherwise export it with your shell or let
# Compose/the supervisor pass it. Empty values mean "use the default".

# debug | info | warn | error
AIRLANCE_AUTH_LOG_LEVEL=info
# json | text
AIRLANCE_AUTH_LOG_FORMAT=json
# Graceful shutdown deadline, a Go duration.
AIRLANCE_AUTH_SHUTDOWN_TIMEOUT=15s
# PostgreSQL connection URL, required by `airlance-auth migrate`. It contains a password: keep it
# out of Git and logs. The value below is the throwaway database of deploy/compose.yaml.
# Every connection limits a statement to 5s, a lock wait to 3s and an idle transaction to 30s, and a
# transaction to 10s; ?statement_timeout=, ?lock_timeout= or ?idle_in_transaction_session_timeout= in the
# URL replace the first three.
# AIRLANCE_AUTH_DATABASE_URL=postgres://airlance_auth:airlance_auth@127.0.0.1:5432/airlance_auth?sslmode=disable
AIRLANCE_AUTH_DATABASE_URL=
# Cap of the connection pool, 1 to 100. Unset keeps the driver default (the larger of 4 and the
# CPU count). Keep the sum over all processes below the server limit (100 by default).
# Half of it at most serves /oauth2/token, /oauth2/introspect and /oauth2/revoke at once; more wait up to
# a second, then get 503.
AIRLANCE_AUTH_DATABASE_MAX_CONNS=
# Schema for the service's tables and its migration history (auth_schema_version); default "auth".
# `migrate up` creates it, so table names cannot collide with other applications in the database.
# A search_path in the connection URL is used instead when this is unset.
AIRLANCE_AUTH_DATABASE_SCHEMA=
# Access token claims and lifetime. Issuer and audience are required once the keyring
# has a jwt_signing purpose.
AIRLANCE_AUTH_JWT_ISSUER=
AIRLANCE_AUTH_JWT_AUDIENCE=
# Default 5m, at most 1h.
AIRLANCE_AUTH_ACCESS_TTL=5m
# Mail delivery. Setting AIRLANCE_AUTH_SMTP_ADDR starts the outbox worker; it also needs
# AIRLANCE_AUTH_DATABASE_URL and an otp_hmac keyring. TLS is mandatory (starttls) unless
# you pick none, which is for the local Mailpit only.
AIRLANCE_AUTH_SMTP_ADDR=
# none | starttls | tls
AIRLANCE_AUTH_SMTP_TLS=starttls
AIRLANCE_AUTH_SMTP_USERNAME=
AIRLANCE_AUTH_SMTP_PASSWORD=
AIRLANCE_AUTH_MAIL_FROM=
AIRLANCE_AUTH_MAIL_FROM_NAME=
# Local development with deploy/compose.yaml:
# AIRLANCE_AUTH_SMTP_ADDR=127.0.0.1:1025
# AIRLANCE_AUTH_SMTP_TLS=none
# AIRLANCE_AUTH_MAIL_FROM=no-reply@auth.example.test
# HTTP API listener. Setting it turns the API on; it also needs AIRLANCE_AUTH_DATABASE_URL and
# both the otp_hmac and jwt_signing keyring purposes. An IP literal with a port: 127.0.0.1:8080 on a
# host behind a local proxy, 0.0.0.0:8080 in a container or a pod. The service speaks plain HTTP and its
# cookies are Secure, so put a TLS-terminating proxy or ingress in front, and name it in
# AIRLANCE_AUTH_TRUSTED_PROXIES: any address beyond the loopback requires that.
AIRLANCE_AUTH_HTTP_ADDR=
# The relying party of passkeys; required with the API (a session needs a passkey). The ID is the
# domain the passkeys are bound to (example.com, or localhost in development; never an IP). Origins
# are the exact origins that may run a ceremony: https pages (http only for localhost) and
# android:apk-key-hash:... for native apps; each web origin must be the ID or one of its subdomains.
AIRLANCE_AUTH_WEBAUTHN_RP_ID=
AIRLANCE_AUTH_WEBAUTHN_RP_NAME=
AIRLANCE_AUTH_WEBAUTHN_ORIGINS=
# Separate listener for GET /metrics, with no authentication. When set, /metrics is no longer served on
# the API listener, so a reverse proxy that publishes the API port does not expose it. Must differ
# from AIRLANCE_AUTH_HTTP_ADDR. Keep it on the loopback, or inside the compose network or the cluster.
AIRLANCE_AUTH_METRICS_ADDR=
# Turns the OpenID Provider (single sign-on for your applications) on and is its issuer: the origin everything is served
# from, such as https://auth.example.com. It must be one of AIRLANCE_AUTH_WEBAUTHN_ORIGINS, needs the HTTP API and an
# oidc_signing (RSA) purpose in the keyring. Applications are registered with `airlance-auth oidc client create`.
AIRLANCE_AUTH_OIDC_ISSUER=
# Internal networks the provider may call to deliver back-channel logout notices to your applications' backends, as
# comma-separated CIDRs or IPs (for example the compose network or the cluster's service range). Loopback, private and
# link-local addresses are refused otherwise. Needed only for backends on an internal network.
AIRLANCE_AUTH_OIDC_BACKCHANNEL_ALLOW=
# Reverse proxies whose X-Forwarded-For is believed, as comma-separated CIDRs or IPs.
# Empty means the TCP peer is the client and the header is ignored. The IP quotas use it.
# A network of every address (0.0.0.0/0, ::/0) is refused.
AIRLANCE_AUTH_TRUSTED_PROXIES=
# Pages of other origins allowed to call the browser profile with cookies, as exact
# comma-separated origins (https://app.example.com; http only for localhost or a loopback
# IP). The API's own origin always works. No wildcards, no paths.
AIRLANCE_AUTH_BROWSER_ORIGINS=
# Who may open an account: open (default) or invite, where only an invited address can register.
# Invitations are made on the server: `airlance-auth invite create EMAIL`.
AIRLANCE_AUTH_REGISTRATION=
# The page an invitation email points to: where an invited address signs in. https, or http for localhost.
# Unset, it is the JWT issuer.
AIRLANCE_AUTH_INVITATION_URL=
# The admin API is a separate listener (same address rules as the API), off while the address is empty. Operators
# sign in with a passkey whose relying party differs from AIRLANCE_AUTH_WEBAUTHN_RP_ID; the origins are the exact
# origins of the admin client (https, or http for localhost). Operators are made on the server: `airlance-auth operator`.
AIRLANCE_AUTH_ADMIN_ADDR=
AIRLANCE_AUTH_ADMIN_RP_ID=
AIRLANCE_AUTH_ADMIN_ORIGINS=
# SameSite of the browser cookies: strict (default), lax or none. none is for a deliberately
# cross-site deployment and needs AIRLANCE_AUTH_BROWSER_ORIGINS.
AIRLANCE_AUTH_COOKIE_SAMESITE=
# Keyring JSON. Unset until a feature needs keys; secrets
# stay in files outside Git, for example under the ignored .secrets/.
AIRLANCE_AUTH_KEYRING_FILE=
